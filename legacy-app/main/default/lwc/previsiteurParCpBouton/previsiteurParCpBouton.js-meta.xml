<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Prévisiteurs par CP — bouton</masterLabel>
    <description>Bouton pour les fiches Piste / Dossiers du portail business saas : ouvre la recherche de prévisiteur (CP prérempli) et l'attribution.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="recordId" type="String" label="Id de la fiche" default="{!recordId}" description="Laisser {!recordId}."/>
            <property name="libelle" type="String" label="Libellé du bouton" default="Chercher un prévisiteur"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
public without sharing class FieldSetController {

    @AuraEnabled(cacheable=true)
    public static FieldSetForm getForm(Id recordId, String objectName, String fieldSetName, String recordTypeId) {
        FieldSetForm form = new FieldSetForm();        
        form.Fields = getFields(recordId, objectName, fieldSetName, recordTypeId);
        return form;
    }
    
    private static List<FormField> getFields(Id recordId, String objectName, String fieldSetName, String recordTypeId) {
        Schema.SObjectType objectType = null;
        System.Debug('Record ID: ' + recordId);
        System.Debug('Object Name: ' + objectName);
        System.Debug('Field Set Name: ' + fieldSetName);
        System.Debug('recordTypeId: ' + recordTypeId);

        if (recordId != null) {
            objectType = recordId.getSobjectType();
        }
        else if (String.isNotBlank(objectName)) {
            objectType = Schema.getGlobalDescribe().get(objectName);
        }
        
        Schema.DescribeSObjectResult objectDescribe = objectType.getDescribe();
        Map<String, Schema.FieldSet> fieldSetMap = objectDescribe.fieldSets.getMap();
        
        RecordType recordType = null;
        if( recordTypeId != null ) {
            recordType = [Select Id, Name, DeveloperName from RecordType where Id = :recordTypeId];
            System.debug('Record Type ' + recordTypeId + ': ' + recordType);
        } else {
            System.debug('No Record Type Id provided.');
        }

        Id profileId=userinfo.getProfileId();
        User connectedUser = [SELECT Id, Name, Profile.Name, Tech_ProfilVirtuel__c FROM User WHERE Id = :UserInfo.getUserId()];
        // String profileName=[Select Id,Name from Profile where Id=:profileId].Name;
        String profileName;
        if( connectedUser.Profile.Name == 'Administrateur Système' || connectedUser.Profile.Name == 'System Administrator') {
            profileName = connectedUser.Tech_ProfilVirtuel__c;
        } else {
            profileName = connectedUser.Profile.Name;
        }
        String fsProfile = 'FS_' + profileName;
        System.debug('Profile Name for ' + connectedUser.Profile.Name + ': ' + profileName);

        // find the field set by name 
        Schema.FieldSet fieldSet = null;
        Schema.FieldSet fieldSetWithRT = null;

        // check wich FS label match fsProfile:
        for (String key : fieldSetMap.keySet()) {
            Schema.FieldSet fs = fieldSetMap.get(key);
            String[] rtNames = new String[]{};
            if(recordType != null && fs.getDescription().contains('RT=')){
                // Test=ABC,DEF,GHI;RT=RT1,RT2;Autre=XYZ
                // extract RT part jusqt after 'RT=' and before next ';' or end of string
                try{
                    String descr = fs.getDescription();
                    Integer rtIndex = descr.indexOf('RT=');
                    Integer semicolonIndex = descr.indexOf(';', rtIndex);
                    if(semicolonIndex == -1) {
                        semicolonIndex = descr.length();
                    }
                    String rtPart = descr.substring(rtIndex + 3, semicolonIndex);
                    rtNames = rtPart.split(',');
                    System.debug('Field Set: ' + fs.getLabel() + ' RT Names: ' + rtPart);
                } catch(Exception e){
                    System.debug('Error parsing RT from Field Set description: ' + e.getMessage());
                    rtNames = new String[]{};
                }
            }
            if (fs.getLabel() == fsProfile) {
                if (rtNames.size() > 0 && recordType != null && rtNames.contains(recordType.DeveloperName)){
                    // fieldSet = fs;
                    fieldSetWithRT = fs;
                    break; // prioritize FS with RT match
                } else if( rtNames.size() == 0 ) {
                    fieldSet = fs;
                }
                System.debug('Found Field Set: ' + fs.getLabel() + ' for Profile: ' + profileName + ' with Desc : ' + fs.getDescription());
                // break;
            } // else if else if...
        }

        if( fieldSetWithRT != null ) {
            fieldSet = fieldSetWithRT;
            System.debug('Using Field Set with Record Type: ' + fieldSet);
        }

        if( fieldSet == null ) {
            fieldSet = fieldSetMap.get(fieldSetName);
            if( fieldSet == null ) {
                // If the field set is not found, return an empty list
                System.debug('Field Set not found: ' + fieldSetName);
                return null;
            }
            System.debug('Using Field Set: ' + fieldSet);
        }


        List<Schema.FieldSetMember> fieldSetMembers = fieldSet.getFields();
        
        List<FormField> fields = new List<FormField>();
        String likeFieldsNames = '%'+fieldSet.getName()+'%';
        System.debug('likeFieldsNames: ' + likeFieldsNames);
        // Retrieve default values from the custom metadata
        Map<String, DynamicPageGenaratorDefaultValues__mdt> defaultValuesMap = new Map<String, DynamicPageGenaratorDefaultValues__mdt>();
        for (DynamicPageGenaratorDefaultValues__mdt mtdRec : [
            SELECT FS_Object_API_Name__c, FS_Field_API_Name__c, FS_Field_Default_Value__c, FS_Field_Visible__c
            FROM DynamicPageGenaratorDefaultValues__mdt
            WHERE FS_Object_API_Name__c = :objectName and FS_FieldSet_API_Name__c LIKE :likeFieldsNames
        ]) {
            System.debug('Metadata Record: ' + mtdRec);
            defaultValuesMap.put(mtdRec.FS_Field_API_Name__c, mtdRec);
        }
        // System.debug('Default Values Map: ' + defaultValuesMap);
        for (Schema.FieldSetMember fsm : fieldSetMembers) {
            FormField f = new FormField(fsm);
            
            // Check if there is a default value for this field
            if (defaultValuesMap.containsKey(f.APIName)) {
                // System.debug('Setting default value for field: ' + f.APIName);
                f.defaultValue = defaultValuesMap.get(f.APIName).FS_Field_Default_Value__c;
                f.isVisible = defaultValuesMap.get(f.APIName).FS_Field_Visible__c; // Use the visibility from metadata
            }
            
            fields.add(f);
        }
        
        return fields;
        }
    
    public class FieldSetForm {
        @AuraEnabled
        public List<FormField> Fields { get; set; }
        
        public FieldSetForm() {
            Fields = new List<FormField>();
        }
    }

    public class FormField {
        public String name;
        public String type;
        @AuraEnabled
        public String APIName { get; set; }
        @AuraEnabled
        public Boolean isRequired { get; set; }
        @AuraEnabled
        public Boolean isVisible { get; set; } // Added for backward compatibility
        public Boolean required;
        @AuraEnabled
        public String defaultValue { get; set; } // Added defaultValue field

        public FormField(Schema.FieldSetMember fsm) {
            this.APIName = fsm.getFieldPath();
            this.IsRequired = fsm.getRequired();
            this.defaultValue = null; // Initialize with null
            this.isVisible = true; // Default visibility to true
        }

        public FormField(String name, String type, Boolean required) {
            this.name = name;
            this.type = type;
            this.required = required;
            this.defaultValue = null;
            this.isVisible = true; // Default visibility to true
        }
    }

    @AuraEnabled(cacheable=true)
    public static Map<String, Object> getFieldSetFields(String objectName, String fieldSetName) {
        Map<String, Object> result = new Map<String, Object>();
        List<Map<String, Object>> champs = new List<Map<String, Object>>();
        result.put('champs', champs);

        if (String.isBlank(objectName) || String.isBlank(fieldSetName)) return result;

        Schema.SObjectType sot = Schema.getGlobalDescribe().get(objectName);
        if (sot == null) return result;

        Map<String, Schema.FieldSet> fsMap = sot.getDescribe().fieldSets.getMap();
        Schema.FieldSet fs = fsMap.get(fieldSetName);
        if (fs == null) {
            for (String key : fsMap.keySet()) {
                if (fsMap.get(key).getLabel() == fieldSetName) {
                    fs = fsMap.get(key);
                    break;
                }
            }
        }
        if (fs == null) return result;

        for (Schema.FieldSetMember m : fs.getFields()) {
            Map<String, Object> f = new Map<String, Object>();
            f.put('apiName', m.getFieldPath());
            f.put('isRequired', m.getRequired() || m.getDBRequired());
            champs.add(f);
        }
        return result;
    }


/**
 * @description Controller for custom file upload component
 * Supports both guest users and authenticated users
 * Returns ContentDocumentId for flexible linking
 */
public without sharing class CustomFileUploadController {

    /**
     * @description Upload file and optionally link to a record
     * @param fileName Name of the file
     * @param base64Data Base64 encoded file data
     * @param contentType MIME type of the file
     * @param recordId Optional record ID to link the file to
     * @return Map containing contentDocumentId, contentVersionId, and contentDocumentLinkId
     */
    @AuraEnabled
    public static Map<String, String> uploadFile(
        String fileName,
        String base64Data,
        String contentType,
        String recordId
    ) {
        try {
            // Validate inputs
            if (String.isBlank(fileName) || String.isBlank(base64Data)) {
                throw new AuraHandledException('Le nom du fichier et les données sont requis');
            }

            // Decode base64 data
            Blob fileBlob = EncodingUtil.base64Decode(base64Data);

            // Validate file size (Salesforce limits)
            Integer fileSizeInBytes = fileBlob.size();
            Integer maxSize = 4500000; // ~4.5MB safe limit for guest users

            if (fileSizeInBytes > maxSize) {
                throw new AuraHandledException('Le fichier est trop volumineux. Taille maximale: ' + (maxSize / 1024 / 1024) + 'MB');
            }

            // Create ContentVersion (this creates the file in Salesforce)
            ContentVersion cv = new ContentVersion();
            cv.Title = fileName;
            cv.PathOnClient = fileName;
            cv.VersionData = fileBlob;
            cv.ContentLocation = 'S'; // S = Salesforce, E = External
            cv.IsMajorVersion = true;

            // Set FirstPublishLocationId if recordId is provided
            if (String.isNotBlank(recordId)) {
                cv.FirstPublishLocationId = recordId;
            }

            insert cv;

            // Query to get the ContentDocumentId
            ContentVersion insertedCV = [
                SELECT Id, ContentDocumentId, Title
                FROM ContentVersion
                WHERE Id = :cv.Id
                LIMIT 1
            ];

            Map<String, String> result = new Map<String, String>();
            result.put('contentVersionId', insertedCV.Id);
            result.put('contentDocumentId', insertedCV.ContentDocumentId);

            // If recordId provided and FirstPublishLocationId didn't work (guest users),
            // create ContentDocumentLink manually
            String contentDocumentLinkId = null;
            if (String.isNotBlank(recordId)) {
                try {
                    // Check if link already exists
                    List<ContentDocumentLink> existingLinks = [
                        SELECT Id
                        FROM ContentDocumentLink
                        WHERE ContentDocumentId = :insertedCV.ContentDocumentId
                        AND LinkedEntityId = :recordId
                        LIMIT 1
                    ];

                    if (existingLinks.isEmpty()) {
                        // Create the link
                        ContentDocumentLink cdl = new ContentDocumentLink();
                        cdl.ContentDocumentId = insertedCV.ContentDocumentId;
                        cdl.LinkedEntityId = recordId;
                        cdl.ShareType = 'V'; // V = Viewer, C = Collaborator, I = Inferred
                        cdl.Visibility = 'AllUsers'; // AllUsers, InternalUsers, SharedUsers

                        insert cdl;
                        contentDocumentLinkId = cdl.Id;
                    } else {
                        contentDocumentLinkId = existingLinks[0].Id;
                    }

                    result.put('contentDocumentLinkId', contentDocumentLinkId);
                } catch (Exception linkEx) {
                    // Link creation failed, but file is uploaded
                    // Return ContentDocumentId so caller can create link later
                    System.debug('Warning: Could not create ContentDocumentLink: ' + linkEx.getMessage());
                }
            }

            return result;

        } catch (Exception e) {
            System.debug('Error in uploadFile: ' + e.getMessage() + '\n' + e.getStackTraceString());
            throw new AuraHandledException('Erreur lors du téléchargement: ' + e.getMessage());
        }
    }

    /**
     * @description Upload multiple files and optionally link to a record
     * @param filesData JSON string containing array of file data objects
     * @param recordId Optional record ID to link the files to
     * @return List of Maps containing upload results for each file
     */
    @AuraEnabled
    public static List<Map<String, Object>> uploadMultipleFiles(String filesData, String recordId) {
        try {
            // Parse the JSON string to get file data
            List<Object> filesList = (List<Object>) JSON.deserializeUntyped(filesData);
            List<Map<String, Object>> results = new List<Map<String, Object>>();

            for (Object fileObj : filesList) {
                Map<String, Object> fileData = (Map<String, Object>) fileObj;
                Map<String, Object> result = new Map<String, Object>();
                result.put('fileName', fileData.get('fileName'));

                try {
                    // Upload each file
                    String fileName = (String) fileData.get('fileName');
                    String base64Data = (String) fileData.get('base64');
                    String contentType = (String) fileData.get('contentType');

                    Map<String, String> uploadResult = uploadFile(fileName, base64Data, contentType, recordId);

                    result.put('success', true);
                    result.put('contentDocumentId', uploadResult.get('contentDocumentId'));
                    result.put('contentVersionId', uploadResult.get('contentVersionId'));
                    result.put('contentDocumentLinkId', uploadResult.get('contentDocumentLinkId'));

                } catch (Exception fileEx) {
                    result.put('success', false);
                    result.put('error', fileEx.getMessage());
                    System.debug('Error uploading file ' + fileData.get('fileName') + ': ' + fileEx.getMessage());
                }

                results.add(result);
            }

            return results;

        } catch (Exception e) {
            System.debug('Error in uploadMultipleFiles: ' + e.getMessage() + '\n' + e.getStackTraceString());
            throw new AuraHandledException('Erreur lors du téléchargement multiple: ' + e.getMessage());
        }
    }

    /**
     * @description Create ContentDocumentLink for an existing ContentDocument
     * Useful when file was uploaded without recordId
     * @param contentDocumentId ContentDocument ID
     * @param recordId Record ID to link to
     * @return ContentDocumentLink ID
     */
    @AuraEnabled
    public static String createContentDocumentLink(String contentDocumentId, String recordId) {
        try {
            if (String.isBlank(contentDocumentId) || String.isBlank(recordId)) {
                throw new AuraHandledException('ContentDocumentId et RecordId sont requis');
            }

            // Check if link already exists
            List<ContentDocumentLink> existingLinks = [
                SELECT Id
                FROM ContentDocumentLink
                WHERE ContentDocumentId = :contentDocumentId
                AND LinkedEntityId = :recordId
                LIMIT 1
            ];

            if (!existingLinks.isEmpty()) {
                return existingLinks[0].Id;
            }

            // Create new link
            ContentDocumentLink cdl = new ContentDocumentLink();
            cdl.ContentDocumentId = contentDocumentId;
            cdl.LinkedEntityId = recordId;
            cdl.ShareType = 'V'; // V = Viewer
            cdl.Visibility = 'AllUsers';

            insert cdl;

            return cdl.Id;

        } catch (Exception e) {
            System.debug('Error in createContentDocumentLink: ' + e.getMessage());
            throw new AuraHandledException('Erreur lors de la création du lien: ' + e.getMessage());
        }
    }

    /**
     * @description Get file information by ContentDocumentId
     * @param contentDocumentId ContentDocument ID
     * @return Map containing file details
     */
    @AuraEnabled(cacheable=true)
    public static Map<String, Object> getFileInfo(String contentDocumentId) {
        try {
            if (String.isBlank(contentDocumentId)) {
                throw new AuraHandledException('ContentDocumentId est requis');
            }

            ContentDocument cd = [
                SELECT Id, Title, FileType, FileExtension, ContentSize, CreatedDate
                FROM ContentDocument
                WHERE Id = :contentDocumentId
                LIMIT 1
            ];

            Map<String, Object> fileInfo = new Map<String, Object>();
            fileInfo.put('id', cd.Id);
            fileInfo.put('title', cd.Title);
            fileInfo.put('fileType', cd.FileType);
            fileInfo.put('fileExtension', cd.FileExtension);
            fileInfo.put('contentSize', cd.ContentSize);
            fileInfo.put('createdDate', cd.CreatedDate);

            return fileInfo;

        } catch (Exception e) {
            System.debug('Error in getFileInfo: ' + e.getMessage());
            throw new AuraHandledException('Erreur lors de la récupération des informations: ' + e.getMessage());
        }
    }


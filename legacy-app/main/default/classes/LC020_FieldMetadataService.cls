public with sharing class LC020_FieldMetadataService {

    @AuraEnabled(cacheable=true)
    public static List<Map<String, Object>> getFieldsMetadata(List<String> fieldApiNames) {
        List<Map<String, Object>> result = new List<Map<String, Object>>();
        if (fieldApiNames == null || fieldApiNames.isEmpty()) return result;

        Map<String, Schema.SObjectField> leadFields = Schema.SObjectType.Lead.fields.getMap();

        for (String apiName : fieldApiNames) {
            Map<String, Object> meta = new Map<String, Object>();
            try {
                meta.put('apiName', apiName);
                if (!leadFields.containsKey(apiName)) {
                    meta.put('label', apiName);
                    meta.put('dataType', 'string');
                    result.add(meta);
                    continue;
                }

                Schema.DescribeFieldResult d = leadFields.get(apiName).getDescribe();
                meta.put('label', d.getLabel());
                Schema.DisplayType dt = d.getType();

                String dataType = 'string';
                if (dt == Schema.DisplayType.BOOLEAN) dataType = 'boolean';
                else if (dt == Schema.DisplayType.CURRENCY) dataType = 'currency';
                else if (dt == Schema.DisplayType.DATE) dataType = 'date';
                else if (dt == Schema.DisplayType.DATETIME) dataType = 'datetime';
                else if (dt == Schema.DisplayType.DOUBLE) dataType = 'double';
                else if (dt == Schema.DisplayType.INTEGER) dataType = 'integer';
                else if (dt == Schema.DisplayType.LONG) dataType = 'long';
                else if (dt == Schema.DisplayType.PERCENT) dataType = 'double';
                else if (dt == Schema.DisplayType.PHONE) dataType = 'phone';
                else if (dt == Schema.DisplayType.TEXTAREA) dataType = 'textarea';
                else if (dt == Schema.DisplayType.EMAIL) dataType = 'email';
                else if (dt == Schema.DisplayType.PICKLIST) dataType = 'picklist';
                else if (dt == Schema.DisplayType.STRING) dataType = 'string';
                else if (dt == Schema.DisplayType.ID) dataType = 'id';
                else if (dt == Schema.DisplayType.REFERENCE) dataType = 'reference';

                meta.put('dataType', dataType);
                meta.put('length', d.getLength());

                if (dataType == 'picklist') {
                    List<Map<String, String>> picks = new List<Map<String, String>>();
                    for (Schema.PicklistEntry pe : d.getPicklistValues()) {
                        Map<String, String> p = new Map<String, String>();
                        p.put('label', pe.getLabel());
                        p.put('value', pe.getValue());
                        picks.add(p);
                    }
                    meta.put('picklistValues', picks);
                }

            } catch (Exception e) {
                meta.put('label', apiName);
                meta.put('dataType', 'string');
            }
            result.add(meta);
        }

        return result;
    }

    @AuraEnabled(cacheable=true)
    public static Map<String, Object> getRecordTypeInfo(Id recordTypeId) {
        Map<String, Object> info = new Map<String, Object>();
        if (recordTypeId == null) return info;

        List<RecordType> rts = [
            SELECT Id, Name, DeveloperName, SobjectType
            FROM RecordType
            WHERE Id = :recordTypeId
            LIMIT 1
        ];

        if (!rts.isEmpty()) {
            RecordType rt = rts[0];
            info.put('Id', rt.Id);
            info.put('Name', rt.Name);
            info.put('DeveloperName', rt.DeveloperName);
            info.put('SobjectType', rt.SobjectType);
        }

        return info;
    }


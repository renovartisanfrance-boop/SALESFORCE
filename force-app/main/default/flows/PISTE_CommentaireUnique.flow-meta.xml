<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <assignments>
        <description
    >Recopie le commentaire télépro (interne) dans le commentaire régie (externe), qui est le seul champ remonté à la conversion.</description>
        <name>Recopier_commentaire_telepro</name>
        <label>Recopier le commentaire télépro</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <assignmentItems>
            <assignToReference
      >$Record.REGIE_Commentaire_Regie__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference
        >$Record.Telepro_Commentaire_pour_Confirmateur__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description
    >Recopie si le commentaire régie est vide, ou s'il contient encore l'ancien commentaire télépro (le télépro vient de le modifier). Un commentaire écrit par un apporteur externe n'est jamais écrasé.</description>
        <name>Faut_il_recopier</name>
        <label>Faut-il recopier ?</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Non</defaultConnectorLabel>
        <rules>
            <name>Oui_recopier</name>
            <conditionLogic>1 OR (2 AND 3)</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.REGIE_Commentaire_Regie__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference
        >$Record.REGIE_Commentaire_Regie__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference
          >$Record__Prior.Telepro_Commentaire_pour_Confirmateur__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference
        >$Record.Telepro_Commentaire_pour_Confirmateur__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference
          >$Record__Prior.Telepro_Commentaire_pour_Confirmateur__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Recopier_commentaire_telepro</targetReference>
            </connector>
            <label>Oui</label>
        </rules>
    </decisions>
    <description
  >Piste : un seul commentaire remonte à la conversion. Quand le commentaire télépro (interne, 255 caractères) est rempli ou modifié, il est recopié dans le commentaire régie (externe, 15 000 caractères), sauf si celui-ci contient un texte d'apporteur externe. Le commentaire télépro est conservé.</description>
    <environments>Default</environments>
    <interviewLabel
  >PISTE_CommentaireUnique {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PISTE_CommentaireUnique</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Faut_il_recopier</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Telepro_Commentaire_pour_Confirmateur__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
